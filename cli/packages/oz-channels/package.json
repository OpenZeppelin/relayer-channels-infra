{
  "name": "@internal/oz-channels",
  "version": "0.1.0",
  "description": "CLI for OpenZeppelin Channels plugin",
  "type": "module",
  "bin": {
    "oz-channels": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run ./src/index.ts",
    "lint": "biome check ./src",
    "format": "biome format --write ./src",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@internal/cli-config": "workspace:*",
    "@openzeppelin/relayer-plugin-channels": "^0.6.0",
    "@openzeppelin/relayer-sdk": "^1.7.0",
    "@stellar/stellar-sdk": "^13.1.0",
    "axios": "^1.7.0",
    "citty": "^0.1.6",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
