# Channels load test — STAGING (Stellar testnet).
#
# Copy this file and fill in your deployment's values:
#   cp env/staging-example.env env/staging.env
#
# Every environment-specific fact for a load-test run lives here, so a run is
# fully described by "profile + env file + commit". Values you export in the
# shell before calling run.sh override anything in this file.
#
# The API key is resolved from the shell, never stored in this file:
#   export CHANNELS_STG_API_KEY=…
API_KEY="${CHANNELS_STG_API_KEY:?export CHANNELS_STG_API_KEY first}"

# ── REQUIRED: update these for your deployment ──────────────────────────────

# The base URL of your channels staging deployment (no trailing slash).
BASE_URL=https://channels-stg.example.com

# test | production. run.sh refuses to run if this is unset, and requires
# ALLOW_PRODUCTION=yes when it is production.
TARGET_KIND=test

# The smoke contract the payloads call. Deploy your own with
# `oz-channels smoke setup` and put its ID here — see SETUP.md.
CONTRACT_ID=<YOUR_STAGING_SMOKE_CONTRACT_ID>

# ── Optional: tune for your environment ─────────────────────────────────────

TEST_TYPE=func-auth-no-auth
PAYLOADS=./payloads.json

# Set P95_MS to your deployment's REQUEST_TIMEOUT_SECONDS (in ms). Latency
# above that value is unreachable — the service cuts the request first.
# Read the live value from your task/service definition rather than guessing.
P95_MS=20000
P99_MS=25000
# Client timeout: keep above the target's own timeout so k6 doesn't cut first.
REQ_TIMEOUT=25s

# Per-type latency gates. The test types differ ~15x in latency, so a blended
# p95 across types gates nothing. Set these from your own measured baselines
# after the first clean runs. These defaults are conservative starting points.
P95_MS_FUNC_AUTH_NO_AUTH=2000
P95_MS_FUNC_AUTH_ADDRESS_AUTH=15000
P95_MS_XDR_PAYMENT=15000
P95_MS_XDR_UNSIGNED_SOROBAN=15000

# sustained profile (MODE=rate).
RATE=3
DURATION=5m
PRE_VUS=5
MAX_VUS=10

# capacity profile (MODE=ramp).
RAMP_MAX=10
RAMP_UP=2m
RAMP_HOLD=2m
