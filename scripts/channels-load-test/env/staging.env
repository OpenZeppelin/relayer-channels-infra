# Channels STAGING (Stellar testnet).
#
# Every environment-specific fact for a load-test run lives here, so a run is
# fully described by "profile + env file + commit". Values you export in the
# shell before calling run.sh override anything in this file.
#
# The API key is resolved from the shell, never stored in this file:
#   export CHANNELS_STG_API_KEY=…
API_KEY="${CHANNELS_STG_API_KEY:?export CHANNELS_STG_API_KEY first}"
BASE_URL=https://channels-stg.openzeppelin.com

# test | production. run.sh refuses to run if this is unset, and requires
# ALLOW_PRODUCTION=yes when it is production.
TARGET_KIND=test

# The smoke contract the payloads call. Deploy your own with
# `oz-channels smoke setup` (packages/oz-channels in this repo) and put its ID
# here — see SETUP.md. This one is OpenZeppelin's staging deployment.
CONTRACT_ID=CDSD3JZBYWZ25FYXXQGQ5EPZOLVM6XPOLREZKN3474SPBWGGTVI3N57S

TEST_TYPE=func-auth-no-auth
PAYLOADS=./payloads.json

# Staging's task definition declares REQUEST_TIMEOUT_SECONDS=20, so latency
# above 20s is unreachable — the service cuts the request first. Re-read the
# live value if runs start reporting p95 pinned at this cap.
P95_MS=20000
P99_MS=25000
# Client timeout: a few seconds above the target's, so k6 never cuts first.
REQ_TIMEOUT=25s

# Per-type latency gates, derived from the measured staging baselines in
# README.md ("Baselines from staging"). A breach means "slower than this
# environment has measured", not "broken" — investigate before re-running.
P95_MS_FUNC_AUTH_NO_AUTH=2000
P95_MS_FUNC_AUTH_ADDRESS_AUTH=15000
P95_MS_XDR_PAYMENT=15000
P95_MS_XDR_UNSIGNED_SOROBAN=15000

# sustained profile (MODE=rate). MAX_VUS is capped at 10: that is the highest
# VU count known to be clean on staging — 20 VUs kills the plugin pool (README
# "Known gaps"). If the rate cannot be sustained inside 10 VUs, that IS the
# finding; raise the cap only deliberately.
RATE=3
DURATION=5m
PRE_VUS=5
MAX_VUS=10

# capacity profile (MODE=ramp). Same ceiling, same reason.
RAMP_MAX=10
RAMP_UP=2m
RAMP_HOLD=2m
