# Channels load test — MAINNET (Stellar public network).
#
# Copy this file and fill in your deployment's values:
#   cp env/mainnet-example.env env/mainnet.env
#
# Warning: this is production. Start with the smoke profile, and only escalate
# load deliberately. xdr-payment spends real (tiny) XLM amounts and real fees.
#
# The API key is resolved from the shell, never stored in this file.
# Never point a staging key at mainnet or vice versa:
#   export CHANNELS_API_KEY=…
API_KEY="${CHANNELS_API_KEY:?export CHANNELS_API_KEY first}"

# ── REQUIRED: update these for your deployment ──────────────────────────────

# The base URL of your channels production deployment (no trailing slash).
BASE_URL=https://channels.example.com

# test | production. run.sh refuses to run if this is unset, and requires
# ALLOW_PRODUCTION=yes when it is production.
TARGET_KIND=production

# The smoke contract the payloads call. Deploy your own with
# `oz-channels smoke setup` and put its ID here — see SETUP.md.
CONTRACT_ID=<YOUR_MAINNET_SMOKE_CONTRACT_ID>

# ── Optional: tune for your environment ─────────────────────────────────────

TEST_TYPE=func-auth-no-auth
PAYLOADS=./payloads.mainnet.json

# Set P95_MS to your deployment's REQUEST_TIMEOUT_SECONDS (in ms). Latency
# above that value is unreachable — the service cuts the request first.
# Read the live value from your task/service definition rather than guessing.
P95_MS=20000
P99_MS=25000
REQ_TIMEOUT=25s

# Per-type latency gates — no baselines exist yet for your mainnet deployment.
# Start from these conservative defaults, then replace with your own measured
# baselines after the first clean runs.
P95_MS_FUNC_AUTH_NO_AUTH=2000
P95_MS_FUNC_AUTH_ADDRESS_AUTH=15000
P95_MS_XDR_PAYMENT=15000
P95_MS_XDR_UNSIGNED_SOROBAN=15000

# sustained profile (MODE=rate) — deliberately gentle for production.
RATE=1
DURATION=2m
PRE_VUS=3
MAX_VUS=5

# capacity profile (MODE=ramp) — do not raise casually on production.
RAMP_MAX=5
RAMP_UP=2m
RAMP_HOLD=1m
