# Channels MAINNET (Stellar public network).
#
# ⚠ This is production. Start with the smoke profile, and only escalate load
# deliberately. xdr-payment spends real (tiny) XLM amounts and real fees.
#
# The API key is resolved from the shell, never stored in this file.
# Never point a staging key at mainnet or vice versa:
#   export CHANNELS_API_KEY=…
API_KEY="${CHANNELS_API_KEY:?export CHANNELS_API_KEY first}"
BASE_URL=https://channels.openzeppelin.com
TARGET_KIND=production

# The pre-deployed mainnet smoke contract — the same ID `oz-channels smoke
# setup` configures on mainnet (packages/oz-channels bundles it).
CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

TEST_TYPE=func-auth-no-auth
PAYLOADS=./payloads.mainnet.json

# UNVERIFIED defaults, copied from staging. Read the mainnet task definition's
# REQUEST_TIMEOUT_SECONDS and replace these before treating a threshold breach
# as a finding. Same for the per-type gates: no mainnet baselines have been
# measured with this harness yet.
P95_MS=20000
P99_MS=25000
REQ_TIMEOUT=25s
P95_MS_FUNC_AUTH_NO_AUTH=2000
P95_MS_FUNC_AUTH_ADDRESS_AUTH=15000
P95_MS_XDR_PAYMENT=15000
P95_MS_XDR_UNSIGNED_SOROBAN=15000

# sustained profile (MODE=rate) — deliberately gentle for production.
RATE=1
DURATION=2m
PRE_VUS=3
MAX_VUS=5

# capacity profile (MODE=ramp) — do not raise casually on production.
RAMP_MAX=5
RAMP_UP=2m
RAMP_HOLD=1m
